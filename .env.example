# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
#
# Demo mode: set DEMO_MODE=true (or just leave STRIPE_SECRET_KEY empty) to run without
# Stripe, Resend or Klaviyo. Only POSTGRES_URL (or DATABASE_URL), AUTH_SECRET and
# OPENAI_API_KEY are needed then.
DEMO_MODE=
OPENAI_MODEL=
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***...
OPENAI_API_KEY=sk-***
RESEND_API_KEY=re_***
KLAVIYO_API_KEY=
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_NEWSLETTER_LIST_ID=
KLAVIYO_CUSTOMERS_LIST_ID=
